<Window x:Class="password.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="帳號密碼紀錄" Height="520" Width="860" MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具列 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="匯出 Excel" Padding="12,4" Margin="0,0,6,0" Click="Export_Click"/>
                <Button Content="匯入 Excel" Padding="12,4" Margin="0,0,6,0" Click="Import_Click"/>
                <Button Content="檢查更新" Padding="12,4" Click="CheckUpdate_Click"/>
            </StackPanel>
            <TextBlock Text="搜尋：" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="SearchBox" Width="220" HorizontalAlignment="Left"
                     VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- 清單（不顯示密碼） -->
            <ListView x:Name="EntryList" Grid.Column="0" Margin="0,0,12,0"
                      SelectionMode="Single" SelectionChanged="EntryList_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="App" Width="200" DisplayMemberBinding="{Binding AppName}"/>
                        <GridViewColumn Header="帳號" Width="220" DisplayMemberBinding="{Binding Username}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- 編輯區 -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="App 名稱"/>
                <TextBox x:Name="AppBox" Margin="0,2,0,8" Padding="2"/>

                <TextBlock Text="帳號"/>
                <TextBox x:Name="UserBox" Margin="0,2,0,8" Padding="2"/>

                <TextBlock Text="密碼"/>
                <Grid Margin="0,2,0,2">
                    <PasswordBox x:Name="PwdBox" Padding="2"/>
                    <TextBox x:Name="PwdText" Padding="2" Visibility="Collapsed"/>
                </Grid>
                <CheckBox x:Name="ShowPwd" Content="顯示密碼" Margin="0,0,0,8"
                          Checked="ShowPwd_Changed" Unchecked="ShowPwd_Changed"/>

                <TextBlock Text="備註"/>
                <TextBox x:Name="NoteBox" Margin="0,2,0,12" Padding="2" Height="60"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                <UniformGrid Columns="2" Rows="2">
                    <Button Content="新增" Margin="0,0,4,4" Padding="0,5" Click="Add_Click"/>
                    <Button Content="儲存修改" Margin="4,0,0,4" Padding="0,5" Click="Save_Click"/>
                    <Button Content="刪除" Margin="0,4,4,0" Padding="0,5" Click="Delete_Click"/>
                    <Button Content="複製密碼" Margin="4,4,0,0" Padding="0,5" Click="CopyPwd_Click"/>
                </UniformGrid>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,8,0,0" Foreground="Gray"/>
    </Grid>
</Window>
