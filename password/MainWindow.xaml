<Window x:Class="password.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password Keeper" Height="860" Width="1260" MinHeight="600" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Background="{DynamicResource AppBgBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- 卡片：白底、細框、大圓角；陰影放在另一層（見 CardShadow），避免內文被模糊 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="CardShadow" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Opacity="0.07" Color="#1E1B4B"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 輸入框上的灰色提示文字：輸入框為空時才顯示 -->
        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- 清單項目：彩色頭像 + App 名稱 + 帳號 + 連結數 -->
        <DataTemplate x:Key="EntryTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="12" Background="{Binding AvatarColor}">
                    <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AppName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Username}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
                <!-- 已連結 App 的數量（沒有連結時隱藏） -->
                <Border Grid.Column="2" CornerRadius="8" Padding="8,3" VerticalAlignment="Center"
                        Background="{DynamicResource AccentSoftBrush}" ToolTip="{DynamicResource S_links_tooltip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71B;" Style="{StaticResource Icon}" FontSize="11"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,1,5,0"/>
                        <TextBlock Text="{Binding LinkCount, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LinkCount}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="28,22,28,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 標題列 ===== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <!-- 工具列：一條白色膠囊裡放幾個透明按鈕 -->
            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <!-- 主題：按一下依序切換 跟隨系統 → 淺色 → 深色（圖示與提示文字由程式設定） -->
                    <Button x:Name="ThemeButton" Style="{StaticResource GhostButton}" Padding="10,8" Click="Theme_Click">
                        <TextBlock x:Name="ThemeIcon" Style="{StaticResource Icon}" Text="&#xE770;"/>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" ToolTip="{DynamicResource S_btn_lang_tip}" Click="Lang_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource S_btn_lang}"/>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Margin="4,8" Background="{DynamicResource LineBrush}"/>
                    <Button Style="{StaticResource GhostButton}" Click="Export_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource S_btn_export}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="Import_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource S_btn_import}"/>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Margin="4,8" Background="{DynamicResource LineBrush}"/>
                    <Button x:Name="ShortcutButton" Style="{StaticResource GhostButton}" ToolTip="{DynamicResource S_btn_shortcut_tip}" Click="Shortcut_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource S_btn_shortcut}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="CheckUpdate_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource S_btn_check_update}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource AccentGradient}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.25" Color="#4F46E5"/>
                </Border.Effect>
                <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="21" Foreground="White"
                           HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource S_app_title}" FontFamily="{StaticResource DisplayFont}"
                           FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="CountText" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="1,1,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ===== 主內容 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- 最左：資料夾（所有項目 / 自訂資料夾 / 無資料夾） -->
            <Border Grid.Column="0" Style="{StaticResource CardShadow}"/>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,16,12,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="6,0,0,10">
                        <Button x:Name="NewFolderButton" DockPanel.Dock="Right" Content="&#xE710;" Style="{StaticResource FieldIconButton}"
                                Width="28" Height="28" FontSize="12" ToolTip="{DynamicResource S_folder_new_tip}" Click="NewFolder_Click"/>
                        <TextBlock Text="{DynamicResource S_folders_title}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListBox x:Name="FolderList" Grid.Row="1" Style="{StaticResource FolderListStyle}" SelectionMode="Single"
                             SelectionChanged="FolderList_SelectionChanged" ContextMenuOpening="FolderList_ContextMenuOpening">
                        <ListBox.ContextMenu>
                            <ContextMenu/>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Display}" FontSize="13" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" ToolTip="{Binding Display}"/>
                                    <TextBlock x:Name="CountLabel" Grid.Column="2" Text="{Binding Count}" FontSize="12" Margin="8,0,4,0"
                                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                    <!-- 滑過自訂資料夾時，數字換成「重新命名 / 刪除」按鈕 -->
                                    <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" Visibility="Collapsed" Margin="4,0,0,0">
                                        <Button Content="&#xE70F;" Style="{StaticResource FieldIconButton}" Width="26" Height="26" FontSize="12"
                                                ToolTip="{DynamicResource S_folder_rename_tip}" Click="RenameFolder_Click"/>
                                        <Button Content="&#xE74D;" Style="{StaticResource IconButton}" FontSize="12"
                                                ToolTip="{DynamicResource S_folder_delete_tip}" Click="DeleteFolder_Click"/>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                            <Condition Binding="{Binding IsUserFolder}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="CountLabel" Property="Visibility" Value="Collapsed"/>
                                    </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 中：搜尋 + 清單 -->
            <Border Grid.Column="2" Style="{StaticResource CardShadow}"/>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,14">
                        <TextBox x:Name="SearchBox" Padding="38,9,12,9" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{DynamicResource SubtleBrush}"
                                   Margin="14,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock Text="{DynamicResource S_search_placeholder}" Margin="40,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ListBox x:Name="EntryList" Grid.Row="1" Style="{StaticResource EntryListStyle}"
                             ItemTemplate="{StaticResource EntryTemplate}" SelectionMode="Single"
                             SelectionChanged="EntryList_SelectionChanged" ContextMenuOpening="EntryList_ContextMenuOpening">
                        <ListBox.ContextMenu>
                            <ContextMenu/>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <!-- 空清單提示 -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource AccentSoftBrush}"
                                HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock Text="&#xE8D7;" Style="{StaticResource Icon}" FontSize="26"
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="EmptyText" TextAlignment="Center" LineHeight="20"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count, ElementName=EntryList}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右：編輯 -->
            <Border Grid.Column="4" Style="{StaticResource CardShadow}"/>
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="20,20,20,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="15"
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource S_form_title}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{DynamicResource S_lbl_app}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="AppBox" Margin="0,0,0,14"/>

                            <TextBlock Text="{DynamicResource S_lbl_folder}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="FolderBox" Margin="0,0,0,14" DisplayMemberPath="Display" SelectedValuePath="Name"/>

                            <TextBlock Text="{DynamicResource S_lbl_user}" Style="{StaticResource FieldLabel}"/>
                            <!-- 帳號欄右側的複製按鈕 -->
                            <Grid Margin="0,0,0,14">
                                <TextBox x:Name="UserBox" Padding="12,8,42,8"/>
                                <Button Content="&#xE8C8;" Style="{StaticResource FieldIconButton}" ToolTip="{DynamicResource S_copy_user_tip}"
                                        HorizontalAlignment="Right" Margin="0,0,4,0" Click="CopyUser_Click"/>
                            </Grid>

                            <TextBlock Text="{DynamicResource S_lbl_pwd}" Style="{StaticResource FieldLabel}"/>
                            <!-- 密碼欄右側：眼睛（顯示 / 隱藏）+ 複製 -->
                            <Grid Margin="0,0,0,14">
                                <PasswordBox x:Name="PwdBox" Padding="12,8,76,8"/>
                                <TextBox x:Name="PwdText" Padding="12,8,76,8" Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                                    <ToggleButton x:Name="ShowPwd" Style="{StaticResource EyeToggle}" ToolTip="{DynamicResource S_show_pwd}"
                                                  Checked="ShowPwd_Changed" Unchecked="ShowPwd_Changed"/>
                                    <Button Content="&#xE8C8;" Style="{StaticResource FieldIconButton}" ToolTip="{DynamicResource S_copy_pwd_tip}"
                                            Margin="2,0,0,0" Click="CopyPwd_Click"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{DynamicResource S_lbl_note}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="NoteBox" Margin="0,0,0,14" Height="60" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                            <!-- 已連結的 App：條列清單，手動輸入 -->
                            <TextBlock Text="{DynamicResource S_lbl_links}" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="LinkBox" KeyDown="LinkBox_KeyDown"/>
                                <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,0" Click="AddLink_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource S_btn_add_link}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Grid MinHeight="38">
                                <ScrollViewer MaxHeight="132" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="LinksList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource InputBgBrush}" CornerRadius="8"
                                                        Padding="12,4,4,4" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}"
                                                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center"
                                                                   TextWrapping="Wrap" FontSize="13"/>
                                                        <Button Grid.Column="2" Content="&#xE711;" ToolTip="{DynamicResource S_remove_tip}"
                                                                Style="{StaticResource IconButton}" Click="RemoveLink_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8"
                                        Padding="12,0" IsHitTestVisible="False">
                                    <TextBlock Text="{DynamicResource S_links_empty}" FontSize="12"
                                               Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center"/>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Items.Count, ElementName=LinksList}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 操作按鈕固定在卡片底部，表單再長也不會被捲出畫面 -->
                    <UniformGrid Grid.Row="2" Columns="3" Rows="1" Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Margin="0,0,5,0" Padding="10,10" Click="Add_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource S_btn_new}"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="5,0,5,0" Padding="10,10" Click="Save_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource S_btn_save}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DangerButton}" Margin="5,0,0,0" Padding="10,10" Click="Delete_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource S_btn_delete}"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 頁尾 ===== -->
        <DockPanel Grid.Row="2" Margin="4,12,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" FontSize="12" Padding="12,6" Click="DeleteAll_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource S_btn_delete_all}"/>
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
