<Window x:Class="password.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="帳號密碼紀錄" Height="680" Width="940" MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBgBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- 卡片外觀 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="1" Opacity="0.08" Color="#1F2433"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 清單項目：字母頭像 + App 名稱 + 帳號 -->
        <DataTemplate x:Key="EntryTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AppName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Username}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 標題列 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="匯出 Excel" Margin="0,0,8,0" Click="Export_Click"/>
                <Button Content="匯入 Excel" Margin="0,0,8,0" Click="Import_Click"/>
                <Button Content="檢查更新" Click="CheckUpdate_Click"/>
            </StackPanel>
            <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentBrush}">
                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="帳號密碼紀錄" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="CountText" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- 左：搜尋 + 清單 -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock Text="搜尋 App、帳號、備註…" Foreground="#9CA3AF" Margin="11,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ListBox x:Name="EntryList" Grid.Row="1" Style="{StaticResource EntryListStyle}"
                             ItemTemplate="{StaticResource EntryTemplate}" SelectionMode="Single"
                             SelectionChanged="EntryList_SelectionChanged"/>

                    <!-- 空清單提示 -->
                    <TextBlock Grid.Row="1" Text="還沒有資料&#x0A;從右邊新增第一筆吧" TextAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count, ElementName=EntryList}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- 右：編輯 -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="帳號資料" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>

                    <TextBlock Text="App 名稱" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="AppBox" Margin="0,0,0,12"/>

                    <TextBlock Text="帳號" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="UserBox" Margin="0,0,0,12"/>

                    <TextBlock Text="密碼" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <PasswordBox x:Name="PwdBox"/>
                        <TextBox x:Name="PwdText" Visibility="Collapsed"/>
                    </Grid>
                    <CheckBox x:Name="ShowPwd" Content="顯示密碼" Margin="2,8,0,12"
                              Checked="ShowPwd_Changed" Unchecked="ShowPwd_Changed"/>

                    <TextBlock Text="備註" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NoteBox" Margin="0,0,0,16" Height="72" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                    <UniformGrid Columns="2" Rows="2">
                        <Button Content="新增" Style="{StaticResource PrimaryButton}" Margin="0,0,5,10" Click="Add_Click"/>
                        <Button Content="儲存修改" Margin="5,0,0,10" Click="Save_Click"/>
                        <Button Content="複製密碼" Margin="0,0,5,0" Click="CopyPwd_Click"/>
                        <Button Content="刪除" Style="{StaticResource DangerButton}" Margin="5,0,0,0" Click="Delete_Click"/>
                    </UniformGrid>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="2,12,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
    </Grid>
</Window>
