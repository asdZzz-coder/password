<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PasswordKeeper</AssemblyName>
    <RootNamespace>password</RootNamespace>
    <Version>1.0.0</Version>
    <StartupObject>password.Program</StartupObject>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- 只保留英文與繁體中文的語系資源，省掉其他語言資料夾 -->
    <SatelliteResourceLanguages>en;zh-Hant</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 自訂 Main（Program.cs），讓 Velopack 能在啟動最前面攔截安裝/更新事件 -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
