<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!--
    直接把要測的原始碼編進測試專案，而不是參考 PasswordKeeper.dll：
    這台電腦的「智慧型應用程式控制」會擋下測試程式載入未簽章的 PasswordKeeper.dll。
  -->
  <ItemGroup>
    <Compile Include="..\password\Services\DesktopShortcutService.cs" Link="Source\DesktopShortcutService.cs" />
    <Compile Include="..\password\Services\DataStore.cs" Link="Source\DataStore.cs" />
    <Compile Include="..\password\Models\AccountEntry.cs" Link="Source\AccountEntry.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
